<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 主内容 -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题栏 -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:background="@color/white"
            android:elevation="1dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="解析结果"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 内容区域 -->
        <ScrollView
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 解析结果区域 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="解析结果"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <!-- 封面 / 播放器容器（固定尺寸 296dp × 200dp，居中） -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <FrameLayout
                                android:id="@+id/videoContainer"
                                android:layout_width="296dp"
                                android:layout_height="200dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_cover">

                                <ImageView
                                    android:id="@+id/ivCover"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop" />

                                <!-- 图集/图文：主预览画廊（左右滑动切换、点击放大、长按保存） -->
                                <androidx.viewpager.widget.ViewPager
                                    android:id="@+id/imagePager"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:visibility="gone" />

                                <WebView
                                    android:id="@+id/videoView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:background="@android:color/transparent"
                                    android:visibility="gone" />

                                <!-- 缓冲加载动画 -->
                                <ProgressBar
                                    android:id="@+id/progressBuffering"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone"
                                    android:indeterminateTint="@color/white" />

                                <FrameLayout
                                    android:id="@+id/btnPlay"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_play_btn"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_play"
                                        android:tint="@color/white" />
                                </FrameLayout>

                                <!-- 播放进度条 -->
                                <SeekBar
                                    android:id="@+id/seekBar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:visibility="gone"
                                    android:progressDrawable="@drawable/seekbar_progress"
                                    android:thumb="@drawable/seekbar_thumb"
                                    android:paddingHorizontal="0dp"
                                    android:maxHeight="3dp"
                                    android:progress="0"
                                    android:max="1000" />

                                <!-- 全屏按钮 -->
                                <ImageView
                                    android:id="@+id/btnFullscreen"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="bottom|end"
                                    android:layout_margin="8dp"
                                    android:layout_marginBottom="10dp"
                                    android:src="@drawable/ic_fullscreen"
                                    android:padding="4dp"
                                    android:background="@drawable/bg_play_btn"
                                    android:visibility="gone"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <!-- 播放时间（当前 / 总时长） -->
                                <TextView
                                    android:id="@+id/tvTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom|start"
                                    android:layout_margin="8dp"
                                    android:layout_marginBottom="10dp"
                                    android:text="00:00 / 00:00"
                                    android:textSize="11sp"
                                    android:textColor="@color/white"
                                    android:background="@drawable/bg_time_label"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:visibility="gone" />

                                <!-- 视频信息（格式 · 时长 · 大小） -->
                                <TextView
                                    android:id="@+id/tvVideoInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|end"
                                    android:layout_margin="8dp"
                                    android:layout_marginTop="10dp"
                                    android:text=""
                                    android:textSize="11sp"
                                    android:textColor="@color/white"
                                    android:background="@drawable/bg_time_label"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </FrameLayout>

                        <!-- 图集/图文内容：横向缩略图条 -->
                        <HorizontalScrollView
                            android:id="@+id/imageScroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:scrollbars="none"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/imageStrip"
                                android:layout_width="wrap_content"
                                android:layout_height="72dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingBottom="2dp" />
                        </HorizontalScrollView>

                        <!-- 平台 & 作者（可点击复制） -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="平台："
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvPlatform"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="作者："
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvAuthor"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:textColor="@color/primary"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="标题："
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground" />
                        </LinearLayout>

                        <!-- 清晰度选择 -->
                        <LinearLayout
                            android:id="@+id/layoutQuality"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="视频源："
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/spinnerQuality"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:minWidth="96dp"
                                android:paddingHorizontal="16dp"
                                android:background="@drawable/bg_input"
                                android:gravity="center"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:drawableEnd="@drawable/ic_arrow_down"
                                android:drawablePadding="6dp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- 保存进度条 -->
                        <LinearLayout
                            android:id="@+id/layoutSaveProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvSaveProgress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="正在保存… 0%"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                            <ProgressBar
                                android:id="@+id/progressSave"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="4dp"
                                android:progressTint="@color/primary"
                                android:progressBackgroundTint="@color/divider" />
                        </LinearLayout>

                        <!-- 操作按钮 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/btnSave"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="保存视频"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:backgroundTint="@color/accent"
                                app:cornerRadius="8dp" />

                            <Button
                                android:id="@+id/btnCopyLink"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="复制链接"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:backgroundTint="@color/primary"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 全屏播放覆盖层（WebView 运行时从内嵌容器移入，保持播放不断） -->
    <FrameLayout
        android:id="@+id/fullscreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnFullscreenExit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:src="@drawable/ic_fullscreen_exit"
            android:padding="8dp"
            android:background="@drawable/bg_play_btn"
            android:clickable="true"
            android:focusable="true" />

        <!-- 全屏视频信息（格式 · 时长 · 大小） -->
        <TextView
            android:id="@+id/tvFullscreenInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:layout_marginTop="64dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_time_label"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
